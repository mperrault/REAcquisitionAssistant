NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Listing-alert IMAP ingestion.
# The app stores only this secret name in source configuration.
REA_LISTING_ALERT_IMAP_PASSWORD=

# OpenAI listing-photo inference.
OPENAI_STYLE_MODEL=gpt-5.6-luna
OPENAI_STYLE_PHOTO_LIMIT=3
# Renovation inference continues to use OPENAI_VISION_MODEL when configured.
OPENAI_VISION_MODEL=
OPENAI_RENOVATION_PHOTO_BATCH_SIZE=8
